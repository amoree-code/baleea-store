# Copy to .env.local for local work. On Vercel, set these in Project → Settings → Environment Variables.
# Names only here — never commit real values.

# Public origin, no trailing slash. Set once the domain is live (e.g. the baleea.iq domain).
# Without it, Vercel's production URL is used.
NEXT_PUBLIC_SITE_URL=

# Sanity (public; the code falls back to the current project if empty).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Secret shared with the Sanity webhook → /api/revalidate. Generate a long random string.
SANITY_REVALIDATE_SECRET=

# Analytics — optional; each loads only when set.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
